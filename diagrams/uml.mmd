classDiagram
    class Owner {
        +str name
        +time window_start
        +time window_end
        +List~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() List~Pet_Task~
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task) void
        +edit_task(task_id, changes) void
        +remove_task(task_id) void
    }

    class Task {
        +int id
        +str name
        +time start_time
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +bool completed
        +datetime created_at
        +date due_date
        +mark_complete() void
        +next_occurrence() Task
        +end_time() time
        +overlaps(other) bool
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +Owner owner
        +List~PlanEntry~ scheduled
        +List~PlanEntry~ dropped
        +sort_by_time(pairs) List~Pet_Task~
        +filter_tasks(pet_name, completed) List~Pet_Task~
        +find_conflicts() List~str~
        +complete_task(pet, task) Task
        +build_plan(day) void
    }

    class PlanEntry {
        <<dataclass>>
        +Task task
        +str pet_name
        +time final_start
        +Outcome outcome
        +str reason
        +time_range() str
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Outcome {
        <<enumeration>>
        KEPT
        MOVED
        DROPPED
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Task --> Priority : uses
    Task --> Frequency : uses
    Scheduler --> Owner : reads
    Scheduler "1" --> "*" PlanEntry : produces
    PlanEntry --> Task : refers to
    PlanEntry --> Outcome : uses
